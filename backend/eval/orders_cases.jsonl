{"id": 3, "text": "جيبلي كرتونة بيض وكيلو سكر", "expect": {"intent": "order", "items": ["بيض", "سكر"], "urgency": "normal"}}
{"id": 4, "text": "محتاج بنادول ضروري لعيل عنده سخونية", "expect": {"intent": "order", "items": ["بنادول"], "urgency": "urgent"}}
