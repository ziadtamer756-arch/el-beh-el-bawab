{"id": 10, "text": "الأسانسير واقف وفيه حد محبوس", "expect": {"intent": "emergency"}}
{"id": 11, "text": "صباح الخير يا عم عبد السميع", "expect": {"intent": "other"}}
{"id": 12, "text": "الدليفري اتأخر قوي ومحدش رد عليا", "expect": {"intent": "other"}}
