{"id": 6, "text": "هات كيلو أرز ومكرونة وزيت", "expect": {"intent": "order", "items": ["أرز", "مكرونة", "زيت"], "urgency": "normal"}}
{"id": 7, "text": "عايز فول وطعمية للفطار بسرعة", "expect": {"intent": "order", "items": ["فول", "طعمية"], "urgency": "urgent"}}
